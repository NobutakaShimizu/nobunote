	"link":{
		"prefix": "link",
		"body":[
			"{{site.baseurl}}/docs/"
		]
	},
	"ref":{
		"prefix": "ref",
		"body":[
			"<a href=\"{{site.baseurl}}/docs/$1)\">$2</a>"
		]
	},
	"figure":{
		"prefix": "fig",
		"body":[
			"{: align=\"center\"}",
			"![text]({{site.baseurl}}/docs/$1){: width=70%}",
